// fastfetch — LW. Cores ANSI do Kitty, então seguem o wallpaper.
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "data",
		"source": "$1 _    __        __\n| |   \\ \\      / /\n| |    \\ \\ /\\ / /\n| |___  \\ V  V /\n|_____|  \\_/\\_/",
		"color": { "1": "cyan", "2": "white" },
		"padding": { "top": 1, "left": 2, "right": 4 }
	},
	"display": {
		"separator": " | ",
		"color": { "keys": "cyan", "title": "cyan" }
	},
	"modules": [
		{ "type": "title", "format": "{user-name}@{host-name}" },
		"break",
		{ "type": "os", "key": "[ OS     ]" },
		{ "type": "kernel", "key": "[ KERNEL ]" },
		{ "type": "wm", "key": "[ WM     ]" },
		{ "type": "shell", "key": "[ SHELL  ]" },
		{ "type": "terminal", "key": "[ TERM   ]" },
		{ "type": "cpu", "key": "[ CPU    ]" },
		{ "type": "gpu", "key": "[ GPU    ]" },
		{ "type": "memory", "key": "[ RAM    ]" },
		{ "type": "disk", "key": "[ DISK   ]", "folders": "/" },
		{ "type": "packages", "key": "[ PKGS   ]" },
		{ "type": "uptime", "key": "[ UP     ]" }
	]
}
