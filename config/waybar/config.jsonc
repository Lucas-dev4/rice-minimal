// config.jsonc — a Waybar do rice (iniciada por scripts/session.py direto deste arquivo).
// Esquerda: workspaces e título da janela. Direita: LW (jogo/música), CPU, RAM, volume e relógio.
// As cores ficam em style.css, que importa as cores do wallpaper geradas pelo theme.py.
{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 8,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-right": [
    "custom/lw",
    "cpu",
    "memory",
    "pulseaudio",
    "clock"
  ],
  // Workspaces como [ 1 ] [ 2 ]...; clique troca.
  "hyprland/workspaces": {
    "format": "[ {id} ]",
    "on-click": "activate",
    "sort-by-number": true
  },
  "hyprland/window": {
    "format": "<span alpha='40%'>|</span> {}",
    "max-length": 36,
    "separate-outputs": true
  },
  // Módulo do LW (extras/lwbar.py): jogo em sessão ou música tocando.
  // Clique abre o LW; clique direito dá play/pause no cliamp.
  "custom/lw": {
    "exec": "/usr/bin/python3 /home/lucas/Projetos/rice-minimal/extras/lwbar.py",
    "return-type": "json",
    "max-length": 48,
    "on-click": "/usr/bin/python3 /home/lucas/Projetos/rice-minimal/extras/lwbar.py click",
    "on-click-right": "/home/lucas/.local/bin/cliamp toggle",
    "tooltip": true
  },
  "cpu": {
    "format": "CPU {usage:02d}% <span alpha='40%'>|</span>",
    "interval": 5
  },
  "memory": {
    "format": "RAM {used:0.1f}G <span alpha='40%'>|</span>",
    "interval": 10
  },
  // Volume: clique muta, rodinha sobe/desce 2%.
  "pulseaudio": {
    "format": "VOL {volume}% <span alpha='40%'>|</span>",
    "format-muted": "VOL mute <span alpha='40%'>|</span>",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d}",
    "interval": 30
  }
}
