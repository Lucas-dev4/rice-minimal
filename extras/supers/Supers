#!/usr/bin/env python3
import os
import re
import sys
import shutil
import curses
import argparse
from pathlib import Path
from safe_io import safe_write, lua_string, normalize_key

CONFIG_PATH = os.path.expanduser("~/.config/hypr/config/binds.lua")
BACKUP_PATH = CONFIG_PATH + ".bak"

def parse_binds(lines):
    binds_info = []
    for i, line in enumerate(lines):
        if line.strip().startswith('hl.bind') and ('mainMod' in line or 'SUPER' in line):
            match = re.match(r'^(.*?hl\.bind\s*\(\s*)(.*)\)(.*)$', line)
            if match:
                inside = match.group(2)

                parts = []
                current = []
                depth_p = 0
                depth_b = 0
                depth_s = 0
                in_str = False
                str_char = ''

                escaped = False
                for char in inside:
                    if in_str and (escaped or char == "\\"):
                        escaped = not escaped
                        current.append(char)
                        continue
                    if char == '"' or char == "'":
                        if not in_str:
                            in_str = True
                            str_char = char
                        elif char == str_char:
                            in_str = False

                    if not in_str:
                        if char == '(': depth_p += 1
                        elif char == ')': depth_p -= 1
                        elif char == '{': depth_b += 1
                        elif char == '}': depth_b -= 1
                        elif char == '[': depth_s += 1
                        elif char == ']': depth_s -= 1
                        elif char == ',' and depth_p == 0 and depth_b == 0 and depth_s == 0:
                            parts.append("".join(current))
                            current = []
                            continue

                    current.append(char)
                if current:
                    parts.append("".join(current))

                if len(parts) >= 2 and normalize_key(parts[0]) is not None:
                    key_exact = parts[0]
                    action_exact = parts[1]

                    binds_info.append({
                        "line_idx": i,
                        "key_exact": key_exact,
                        "key_clean": key_exact.strip(),
                        "action_exact": action_exact,
                        "action_clean": action_exact.strip(),
                        "raw_line": line
                    })
    return binds_info

def format_lua_key(user_input):
    nk = re.sub(r'^(super|mainmod)\s*\+\s*', '', user_input.strip(), flags=re.IGNORECASE)
    nk = re.sub(r'\bshitf\b', 'SHIFT', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\bshift\b', 'SHIFT', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\balt\b', 'ALT', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\bctrl\b', 'CONTROL', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\bcontrol\b', 'CONTROL', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\bespace\b', 'Space', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\bspace\b', 'Space', nk, flags=re.IGNORECASE)
    if not re.fullmatch(r'(?:SHIFT|ALT|CONTROL|SUPER|[A-Za-z0-9_:.-]+)(?:\s*\+\s*(?:SHIFT|ALT|CONTROL|[A-Za-z0-9_:.-]+))*', nk):
        raise ValueError("Combinação inválida")
    return 'mainMod .. ' + lua_string(' + ' + nk)

def main():
    global CONFIG_PATH
    parser = argparse.ArgumentParser(description='Super: edita atalhos Lua estáticos; preserva loops e expressões dinâmicas.')
    parser.add_argument('config', nargs='?', default=CONFIG_PATH)
    parser.add_argument('--check', action='store_true')
    parser.add_argument('--restore', metavar='BACKUP')
    args = parser.parse_args()
    CONFIG_PATH = str(Path(args.config).expanduser())
    if args.restore:
        backup = Path(args.restore).expanduser().resolve()
        target = Path(CONFIG_PATH).resolve()
        if backup.parent != target.parent or not backup.name.startswith(target.name + '.supers-') or backup.suffix != '.bak':
            parser.error('Use um backup .supers-*.bak do mesmo arquivo')
        saved = safe_write(CONFIG_PATH, target.read_text(), backup.read_text())
        print('Restaurado; estado anterior preservado em', saved)
        return
    if args.check:
        import subprocess
        subprocess.run(['luac', '-p', CONFIG_PATH], check=True)
        binds = parse_binds(Path(CONFIG_PATH).read_text().splitlines(True))
        keys = [normalize_key(b['key_clean']) for b in binds]
        if len(keys) != len(set(keys)):
            parser.error('Atalhos estáticos duplicados')
        print(f'{len(binds)} atalhos estáticos válidos; expressões dinâmicas preservadas')
        return
    try:
        sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
        from shortcuts import selector
        import ui
        def shared(screen):
            ui.setup(screen)
            selector(screen, CONFIG_PATH)
        curses.wrapper(shared)
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
