#!/usr/bin/env python3
import os
import re
import sys
import shutil
import curses
import argparse
from pathlib import Path
from safe_io import safe_write, lua_string, normalize_key

CONFIG_PATH = os.path.expanduser("~/.config/hypr/config/binds.lua")
BACKUP_PATH = CONFIG_PATH + ".bak"

def parse_binds(lines):
    binds_info = []
    for i, line in enumerate(lines):
        if line.strip().startswith('hl.bind') and ('mainMod' in line or 'SUPER' in line):
            match = re.match(r'^(.*?hl\.bind\s*\(\s*)(.*)\)(.*)$', line)
            if match:
                inside = match.group(2)

                parts = []
                current = []
                depth_p = 0
                depth_b = 0
                depth_s = 0
                in_str = False
                str_char = ''

                escaped = False
                for char in inside:
                    if in_str and (escaped or char == "\\"):
                        escaped = not escaped
                        current.append(char)
                        continue
                    if char == '"' or char == "'":
                        if not in_str:
                            in_str = True
                            str_char = char
                        elif char == str_char:
                            in_str = False

                    if not in_str:
                        if char == '(': depth_p += 1
                        elif char == ')': depth_p -= 1
                        elif char == '{': depth_b += 1
                        elif char == '}': depth_b -= 1
                        elif char == '[': depth_s += 1
                        elif char == ']': depth_s -= 1
                        elif char == ',' and depth_p == 0 and depth_b == 0 and depth_s == 0:
                            parts.append("".join(current))
                            current = []
                            continue

                    current.append(char)
                if current:
                    parts.append("".join(current))

                if len(parts) >= 2 and normalize_key(parts[0]) is not None:
                    key_exact = parts[0]
                    action_exact = parts[1]

                    binds_info.append({
                        "line_idx": i,
                        "key_exact": key_exact,
                        "key_clean": key_exact.strip(),
                        "action_exact": action_exact,
                        "action_clean": action_exact.strip(),
                        "raw_line": line
                    })
    return binds_info

def format_lua_key(user_input):
    nk = re.sub(r'^(super|mainmod)\s*\+\s*', '', user_input.strip(), flags=re.IGNORECASE)
    nk = re.sub(r'\bshitf\b', 'SHIFT', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\bshift\b', 'SHIFT', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\balt\b', 'ALT', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\bctrl\b', 'CONTROL', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\bcontrol\b', 'CONTROL', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\bespace\b', 'Space', nk, flags=re.IGNORECASE)
    nk = re.sub(r'\bspace\b', 'Space', nk, flags=re.IGNORECASE)
    if not re.fullmatch(r'(?:SHIFT|ALT|CONTROL|SUPER|[A-Za-z0-9_:.-]+)(?:\s*\+\s*(?:SHIFT|ALT|CONTROL|[A-Za-z0-9_:.-]+))*', nk):
        raise ValueError("Combinação inválida")
    return 'mainMod .. ' + lua_string(' + ' + nk)

def get_string(stdscr, prompt, default_y, default_x, max_width=100):
    curses.echo()
    curses.curs_set(1)
    stdscr.addstr(default_y, default_x, prompt, curses.A_BOLD)
    stdscr.refresh()

    try:
        s = stdscr.getstr(default_y, default_x + len(prompt), max_width).decode('utf-8')
    except Exception:
        s = ""

    curses.noecho()
    curses.curs_set(0)
    return s.strip()

def draw_box_with_title(stdscr, y, x, h, w, title, border_color):
    # Desenha as bordas da caixa
    stdscr.attron(border_color)
    stdscr.addch(y, x, curses.ACS_ULCORNER)
    stdscr.hline(y, x+1, curses.ACS_HLINE, w-2)
    stdscr.addch(y, x+w-1, curses.ACS_URCORNER)

    stdscr.addch(y+h-1, x, curses.ACS_LLCORNER)
    stdscr.hline(y+h-1, x+1, curses.ACS_HLINE, w-2)
    stdscr.addch(y+h-1, x+w-1, curses.ACS_LRCORNER)

    for i in range(1, h-1):
        stdscr.addch(y+i, x, curses.ACS_VLINE)
        stdscr.addch(y+i, x+w-1, curses.ACS_VLINE)
    stdscr.attroff(border_color)

    # Adiciona o título centralizado na borda superior
    if title:
        stdscr.attron(curses.color_pair(3) | curses.A_BOLD)
        stdscr.addstr(y, x + max(2, (w - len(title) - 2) // 2), f" {title} ")
        stdscr.attroff(curses.color_pair(3) | curses.A_BOLD)

def main_tui(stdscr):
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()

    # Paleta de cores moderna
    curses.init_pair(1, -1, -1)                    # Padrão
    curses.init_pair(2, curses.COLOR_CYAN, -1)     # Bordas, Cabeçalhos e Destaques
    curses.init_pair(3, curses.COLOR_YELLOW, -1)   # Avisos / Títulos de caixas
    curses.init_pair(4, curses.COLOR_GREEN, -1)    # Sucesso / Novo conteúdo
    curses.init_pair(5, curses.COLOR_RED, -1)      # Remoções / Erros

    if not os.path.exists(CONFIG_PATH):
        stdscr.addstr(1, 2, f"Erro: O arquivo {CONFIG_PATH} não existe.", curses.color_pair(5) | curses.A_BOLD)
        stdscr.addstr(3, 2, "Pressione qualquer tecla para sair...")
        stdscr.getch()
        sys.exit(1)

    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            lines = f.readlines()
    except Exception as e:
        stdscr.addstr(1, 2, f"Erro ao ler arquivo: {e}", curses.color_pair(5) | curses.A_BOLD)
        stdscr.addstr(3, 2, "Pressione qualquer tecla para sair...")
        stdscr.getch()
        sys.exit(1)

    binds_info = parse_binds(lines)
    if not binds_info:
        stdscr.addstr(1, 2, "Nenhum atalho com a tecla Super encontrado.", curses.color_pair(3))
        stdscr.addstr(3, 2, "Pressione qualquer tecla para sair...")
        stdscr.getch()
        return

    current_row = 0
    top_row = 0

    while True:
        stdscr.clear()
        H, W = stdscr.getmaxyx()

        # Proteção para redimensionamento
        if H < 10 or W < 50:
            stdscr.addstr(0, 0, "Terminal muito pequeno!", curses.color_pair(5))
            stdscr.refresh()
            if stdscr.getch() == ord('q'): break
            continue

        # --- HEADER ---
        header = " SUPERS - GERENCIADOR DE ATALHOS HYPRLAND "
        stdscr.attron(curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
        stdscr.addstr(0, 0, header.center(W))
        stdscr.attroff(curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)

        # --- FOOTER ---
        footer = "  [↑/↓] Navegar   [ENTER] Editar   [Q] Sair  "
        stdscr.attron(curses.color_pair(2) | curses.A_REVERSE)
        try:
            stdscr.addstr(H - 1, 0, footer.center(W)[:W-1])
        except curses.error:
            pass
        stdscr.attroff(curses.color_pair(2) | curses.A_REVERSE)

        # --- MAIN PANEL ---
        box_h = H - 3
        box_w = min(W - 4, 120)
        box_y = 1
        box_x = (W - box_w) // 2

        draw_box_with_title(stdscr, box_y, box_x, box_h, box_w, "Atalhos Encontrados", curses.color_pair(2))

        # --- CONTENT ---
        max_items = box_h - 2
        if current_row < top_row:
            top_row = current_row
        elif current_row >= top_row + max_items:
            top_row = current_row - max_items + 1

        for i in range(max_items):
            idx = top_row + i
            if idx >= len(binds_info):
                break

            b = binds_info[idx]
            kc = b['key_clean'].replace('mainMod .. ', 'SUPER').replace('"', '').replace(' ', '')
            ac = b['action_clean']

            # Espaço disponível dentro da caixa com margens
            avail_w = box_w - 6
            kc_w = min(28, avail_w // 3)
            ac_w = avail_w - kc_w - 5 # 5 for "  :  "

            if len(ac) > ac_w:
                ac = ac[:ac_w-3] + "..."

            kc_disp = kc.ljust(kc_w)[:kc_w]

            line_y = box_y + 1 + i
            line_x = box_x + 2

            if idx == current_row:
                # Destaque invertido e negrito para o item selecionado
                stdscr.attron(curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
                full_line = f" ➜ {kc_disp} : {ac}"
                full_line = full_line.ljust(avail_w + 2)
                stdscr.addstr(line_y, line_x, full_line)
                stdscr.attroff(curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
            else:
                full_line = f"   {kc_disp} : {ac}"
                full_line = full_line.ljust(avail_w + 2)
                stdscr.addstr(line_y, line_x, full_line)

        stdscr.refresh()
        key = stdscr.getch()

        if key == curses.KEY_RESIZE:
            continue # O laço vai limpar e redesenhar baseado no novo tamanho
        elif key == ord('q') or key == ord('Q'):
            break
        elif key == curses.KEY_UP or key == ord('k') or key == ord('K'):
            if current_row > 0:
                current_row -= 1
        elif key == curses.KEY_DOWN or key == ord('j') or key == ord('J'):
            if current_row < len(binds_info) - 1:
                current_row += 1
        elif key in [curses.KEY_ENTER, 10, 13]:
            # --- TELA DE EDIÇÃO ---
            selected_bind = binds_info[current_row]
            kc = selected_bind['key_clean'].replace('mainMod .. ', 'SUPER').replace('"', '').replace(' ', '')

            stdscr.clear()

            # Header e Panel para edição
            stdscr.attron(curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
            stdscr.addstr(0, 0, header.center(W))
            stdscr.attroff(curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)

            draw_box_with_title(stdscr, box_y, box_x, box_h, box_w, "Editar Combinação", curses.color_pair(2))

            cy = box_y + 2
            cx = box_x + 4

            stdscr.addstr(cy, cx, "Atalho atual:", curses.color_pair(4) | curses.A_BOLD)
            stdscr.addstr(cy, cx + 15, kc)
            stdscr.addstr(cy + 1, cx, "Ação atual:", curses.color_pair(4) | curses.A_BOLD)
            stdscr.addstr(cy + 1, cx + 15, selected_bind['action_clean'][:box_w-20])

            stdscr.addstr(cy + 3, cx, "Deixe em branco para manter o valor atual.", curses.color_pair(3))

            new_key = get_string(stdscr, "Nova combinação (ex: SUPER + Space): ", cy + 5, cx, box_w-10)
            new_cmd = get_string(stdscr, "Novo comando (ex: firefox): ", cy + 7, cx, box_w-10)

            if not new_key and not new_cmd:
                stdscr.addstr(cy + 10, cx, "Nenhuma modificação feita. Pressione qualquer tecla...", curses.color_pair(3))
                stdscr.getch()
                continue

            old_line = lines[selected_bind['line_idx']]
            new_line = old_line

            if new_cmd:
                leading_spaces = len(selected_bind['action_exact']) - len(selected_bind['action_exact'].lstrip())
                new_action_with_spaces = (" " * leading_spaces) + f'hl.dsp.exec_cmd({lua_string(new_cmd)})'
                new_line = new_line.replace(selected_bind['action_exact'], new_action_with_spaces, 1)

            if new_key:
                try:
                    new_key_lua = format_lua_key(new_key)
                    for other in binds_info:
                        if other['line_idx'] != selected_bind['line_idx'] and normalize_key(other['key_clean']) == normalize_key(new_key_lua):
                            raise ValueError('Atalho já utilizado')
                except ValueError as error:
                    stdscr.addstr(cy + 9, cx, str(error)[:box_w-10])
                    stdscr.getch()
                    continue
                new_line = new_line.replace(selected_bind['key_exact'], new_key_lua, 1)

            # --- TELA DE CONFIRMAÇÃO ---
            stdscr.clear()
            stdscr.attron(curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
            stdscr.addstr(0, 0, header.center(W))
            stdscr.attroff(curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)

            draw_box_with_title(stdscr, box_y, box_x, box_h, box_w, "Confirmação de Modificação", curses.color_pair(3))

            stdscr.addstr(cy, cx, "Antes: ", curses.color_pair(5) | curses.A_BOLD)
            stdscr.addstr(cy, cx + 8, old_line.strip()[:box_w-15])

            stdscr.addstr(cy+2, cx, "Depois: ", curses.color_pair(4) | curses.A_BOLD)
            stdscr.addstr(cy+2, cx + 9, new_line.strip()[:box_w-15])

            confirm = get_string(stdscr, "Aplicar alteração no arquivo? (s/N): ", cy+5, cx, 10).lower()

            if confirm == 's':
                try:
                    candidate = lines.copy()
                    candidate[selected_bind['line_idx']] = new_line
                    safe_write(CONFIG_PATH, ''.join(lines), ''.join(candidate))
                    lines = candidate
                    stdscr.addstr(cy+8, cx, "✔ Sucesso! Arquivo atualizado. Backup salvo.", curses.color_pair(4) | curses.A_BOLD)
                    binds_info = parse_binds(lines)
                except Exception as e:
                    stdscr.addstr(cy+8, cx, f"✖ Erro ao salvar: {e}", curses.color_pair(5) | curses.A_BOLD)
            else:
                stdscr.addstr(cy+8, cx, "Alteração cancelada.", curses.color_pair(3))

            stdscr.addstr(cy+10, cx, "Pressione qualquer tecla para continuar...")
            stdscr.getch()

def main():
    global CONFIG_PATH
    parser = argparse.ArgumentParser(description='Super: edita atalhos Lua estáticos; preserva loops e expressões dinâmicas.')
    parser.add_argument('config', nargs='?', default=CONFIG_PATH)
    parser.add_argument('--check', action='store_true')
    parser.add_argument('--restore', metavar='BACKUP')
    args = parser.parse_args()
    CONFIG_PATH = str(Path(args.config).expanduser())
    if args.restore:
        backup = Path(args.restore).expanduser().resolve()
        target = Path(CONFIG_PATH).resolve()
        if backup.parent != target.parent or not backup.name.startswith(target.name + '.supers-') or backup.suffix != '.bak':
            parser.error('Use um backup .supers-*.bak do mesmo arquivo')
        saved = safe_write(CONFIG_PATH, target.read_text(), backup.read_text())
        print('Restaurado; estado anterior preservado em', saved)
        return
    if args.check:
        import subprocess
        subprocess.run(['luac', '-p', CONFIG_PATH], check=True)
        binds = parse_binds(Path(CONFIG_PATH).read_text().splitlines(True))
        keys = [normalize_key(b['key_clean']) for b in binds]
        if len(keys) != len(set(keys)):
            parser.error('Atalhos estáticos duplicados')
        print(f'{len(binds)} atalhos estáticos válidos; expressões dinâmicas preservadas')
        return
    try:
        curses.wrapper(main_tui)
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
